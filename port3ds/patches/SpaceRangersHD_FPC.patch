+{$IFDEF CTR}
+// Ranged reads let large animations be read frame by frame (see TCGaiEC).
+function TDataEC.GetEntrySize(Entry: TDataElEC): Integer;
+begin
+  VerifyResourceFileChecksum(Entry.SharedFileRef.FileRef.FileName);
+  Result := Entry.ByteCount;
+  if Result >= 0 then
+    Exit;
+  FileLock.Enter;
+  try
+    Entry.SharedFileRef.FileRef.AcquireReadWriteHandle;
+    try
+      Result := Entry.SharedFileRef.FileRef.GetSize - Entry.FileOffset;
+    finally
+      Entry.SharedFileRef.FileRef.ReleaseHandle;
+    end;
+  finally
+    FileLock.Leave;
+  end;
+end;
+
+procedure TDataEC.ReadEntryRange(
+    Entry: TDataElEC;
+    Offset: Cardinal;
+    Dest: Pointer;
+    ByteCount: Cardinal
+);
+begin
+  if ByteCount = 0 then
+    Exit;
+  FileLock.Enter;
+  try
+    Entry.SharedFileRef.FileRef.AcquireReadWriteHandle;
+    try
+      Entry.SharedFileRef.FileRef.SetPointer(Entry.FileOffset + Offset, fsFromBeginning);
+      Entry.SharedFileRef.FileRef.ReadBuffer(Dest, ByteCount);
+    finally
+      Entry.SharedFileRef.FileRef.ReleaseHandle;
+    end;
+  finally
+    FileLock.Leave;
+  end;
+end;
+{$ENDIF}
