+{$IFDEF CTR}
+function fpcctr_fs_generation: Cardinal; cdecl; external name 'fpcctr_fs_generation';
+
+type
+  TCachedName = class
+    Name: UnicodeString;
+  end;
+
+  // Entries of one folder keyed by their lower-case UTF-8 name.
+  TCachedDirectory = class
+    Names: TStringList;
+    constructor Create;
+    destructor Destroy; override;
+  end;
+
+var
+  // Each stat or directory scan is an FS service round trip on the 3DS, and
+  // the loose-file package probes the game folder before every resource.
+  // Folder listings are kept until the RTL reports a created, renamed or
+  // deleted entry.
+  DirectoryCache: TStringList = nil;
+  DirectoryCacheLock: TRTLCriticalSection;
+  DirectoryCacheGeneration: Cardinal = 0;
+
+constructor TCachedDirectory.Create;
+begin
+  Names := TStringList.Create;
+  Names.Sorted := True;
+  Names.CaseSensitive := True;
+  Names.Duplicates := dupAccept;
+  Names.OwnsObjects := True;
+end;
+
+destructor TCachedDirectory.Destroy;
+begin
+  Names.Free;
+  inherited Destroy;
+end;
+
+function LoadCachedDirectory(const Directory: UnicodeString): TCachedDirectory;
+var
+  Entry: TUnicodeSearchRec;
+  Item: TCachedName;
+begin
+  Result := TCachedDirectory.Create;
+  if FindFirst(Directory + '*', faAnyFile, Entry) = 0 then
+    try
+      repeat
+        Item := TCachedName.Create;
+        Item.Name := Entry.Name;
+        Result.Names.AddObject(UTF8Encode(UnicodeLowerCase(Entry.Name)), Item);
+      until FindNext(Entry) <> 0;
+    finally
+      FindClose(Entry);
+    end;
+end;
+
+function FindCachedDirectoryEntry(const Directory, Name: UnicodeString; out RealName: UnicodeString): Boolean;
+var
+  Index: Integer;
+  Generation: Cardinal;
+  Cached: TCachedDirectory;
+begin
+  EnterCriticalSection(DirectoryCacheLock);
+  try
+    Generation := fpcctr_fs_generation;
+    if Generation <> DirectoryCacheGeneration then
+    begin
+      DirectoryCache.Clear;
+      DirectoryCacheGeneration := Generation;
+    end;
+    if DirectoryCache.Find(UTF8Encode(Directory), Index) then
+      Cached := TCachedDirectory(DirectoryCache.Objects[Index])
+    else
+    begin
+      Cached := LoadCachedDirectory(Directory);
+      DirectoryCache.AddObject(UTF8Encode(Directory), Cached);
+    end;
+    Result := Cached.Names.Find(UTF8Encode(UnicodeLowerCase(Name)), Index);
+    if Result then
+      RealName := TCachedName(Cached.Names.Objects[Index]).Name;
+  finally
+    LeaveCriticalSection(DirectoryCacheLock);
+  end;
+end;
+
+function IsVolumeRoot(const Directory: UnicodeString): Boolean;
+begin
+  Result := (Directory = '/') or (Copy(Directory, Length(Directory) - 1, 2) = ':/');
+end;
+
+function ResolveGamePathCase(const Path: UnicodeString): UnicodeString;
+var
+  Directory, Name, RealName: UnicodeString;
+begin
+  Result := Path;
+  if Path = '' then
+    Exit;
+  Name := ExtractFileName(Path);
+  Directory := ExtractFilePath(Path);
+  if Name = '' then
+  begin
+    if IsVolumeRoot(Path) then
+      Exit;
+    Exit(IncludeTrailingPathDelimiter(ResolveGamePathCase(ExcludeTrailingPathDelimiter(Path))));
+  end;
+  // Resolve every component so loose mods retain Windows filename matching
+  // on the case-sensitive SD card; missing entries keep the requested case.
+  if (Directory <> '') and not IsVolumeRoot(Directory) then
+    Directory := IncludeTrailingPathDelimiter(
+      ResolveGamePathCase(ExcludeTrailingPathDelimiter(Directory)));
+  if (Name <> '.') and (Name <> '..') and
+     FindCachedDirectoryEntry(Directory, Name, RealName) then
+    Result := Directory + RealName
+  else
+    Result := Directory + Name;
+end;
