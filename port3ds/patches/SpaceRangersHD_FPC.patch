+{$IFDEF CTR}
+procedure TgiGR.ParseScaleMarker;
+begin
+  ScaleShift := 0;
+  if (Header = nil) or ((Cardinal(Header.Version) and $FFFF0000) <> GiScaleMarker) then
+    Exit;
+  ScaleShift := Header.Version and $FF;
+  LogicalBounds.Left := PSmallInt(@Header.Gap38[0])^;
+  LogicalBounds.Top := PSmallInt(@Header.Gap38[2])^;
+  LogicalBounds.Right := LogicalBounds.Left + PWord(@Header.Gap38[4])^;
+  LogicalBounds.Bottom := LogicalBounds.Top + PWord(@Header.Gap38[6])^;
+end;
+
+function TgiGR.GetStoredSize: TPoint;
+begin
+  if Header = nil then
+    Exit(Point(0, 0));
+  Result.X := Header.Bounds.Right - Header.Bounds.Left;
+  Result.Y := Header.Bounds.Bottom - Header.Bounds.Top;
+end;
