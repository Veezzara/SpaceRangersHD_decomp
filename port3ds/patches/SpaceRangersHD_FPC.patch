+// a PC with a disk cache but makes reading a large entry quadratic in FS
+// service calls on the 3DS. Resume the walk from the last block located; the
+// file position afterwards is the same (just past the block's size header).
+function TPackFileEC.LocateChainedBlock(SlotIndex, BlockIndex: Cardinal): Cardinal;
+var
+  Index, Offset, StoredSize, BytesRead: Cardinal;
+begin
+  if (OpenSlots[SlotIndex].KnownBlockIndex >= 0)
+      and (Cardinal(OpenSlots[SlotIndex].KnownBlockIndex) <= BlockIndex) then
+  begin
+    Index := OpenSlots[SlotIndex].KnownBlockIndex;
+    Offset := OpenSlots[SlotIndex].KnownBlockOffset;
+  end
+  else
+  begin
+    Index := 0;
+    Offset := OpenSlots[SlotIndex].DataStartOffset;
+  end;
+  while True do
+  begin
+    FileSeek(PackageHandle, Int64(Offset), fsFromBeginning);
+    ReadPackageFile(PackageHandle, StoredSize, SizeOf(StoredSize), BytesRead);
+    if Index = BlockIndex then
+      Break;
+    Inc(Index);
+    Offset := Offset + StoredSize + SizeOf(StoredSize);
+  end;
+  OpenSlots[SlotIndex].KnownBlockIndex := Index;
+  OpenSlots[SlotIndex].KnownBlockOffset := Offset;
