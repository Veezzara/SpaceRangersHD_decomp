+var
+  WarnedScaledDraw: Boolean;
+
+// X, Y place the logical top left. A downscaled image is drawn one logical
+// pixel at a time, placing the stored image so that the stored pixel covering
+// that logical pixel lands on it. This serves pixel hit tests (one pixel);
+// the software renderer paths that draw whole images are not used with
+// hardware rendering.
+procedure TgiGR.DrawToGraphBuf(
+    GraphBuf: TGraphBufGR;
+    X, Y: Integer;
+    DrawRect: TRect;
+    BlendMode, Alpha: Byte
+);
+var
+  Area: TRect;
+  PX, PY: Integer;
+begin
+  if (Header = nil) or (ScaleShift = 0) then
+  begin
+    if Header <> nil then
+      DrawStoredToGraphBuf(GraphBuf, X, Y, DrawRect, BlendMode, Alpha);
+    Exit;
+  end;
+  Area := Classes.Rect(
+      X, Y, X + LogicalBounds.Right - LogicalBounds.Left, Y + LogicalBounds.Bottom - LogicalBounds.Top);
+  if not IntersectRect(Area, Area, DrawRect) then
+    Exit;
+  if ((Area.Right - Area.Left) * (Area.Bottom - Area.Top) > 1) and not WarnedScaledDraw then
+  begin
+    WarnedScaledDraw := True;
+    AppendLogLineThreadSafe('DrawToGraphBuf: drawing a downscaled image pixel by pixel');
+  end;
+  for PY := Area.Top to Area.Bottom - 1 do
+    for PX := Area.Left to Area.Right - 1 do
+      DrawStoredToGraphBuf(
+          GraphBuf,
+          PX - ((PX - X) shr ScaleShift),
+          PY - ((PY - Y) shr ScaleShift),
+          Classes.Rect(PX, PY, PX + 1, PY + 1),
+          BlendMode,
+          Alpha
+      );
+end;
+
+// Decodes at the stored size, then enlarges a downscaled image to its
+// logical size.
+procedure TgiGR.DecodeToGraphBuf(GraphBuf: TGraphBufGR; Keep16BitPixels: Boolean);
+var
+  Stored: TGraphBufGR;
+  Bpp, X, Y, Width, Height: Integer;
+  Source, Dest: PByte;
+begin
+  if (ScaleShift = 0) or (Header.Format > 4) then
+  begin
+    DecodeStoredToGraphBuf(GraphBuf, Keep16BitPixels);
+    Exit;
+  end;
+  Stored := TGraphBufGR.Create(False);
+  try
+    DecodeStoredToGraphBuf(Stored, Keep16BitPixels);
+    if (Header.Format = 0) and (Header.AlphaMask = 0) and Keep16BitPixels then
+      Bpp := 2
+    else
+      Bpp := 4;
+    Width := LogicalBounds.Right - LogicalBounds.Left;
+    Height := LogicalBounds.Bottom - LogicalBounds.Top;
+    GraphBuf.AllocateRgba(Width, Height, Width * SizeOf(TColorRGBA));
+    for Y := 0 to Height - 1 do
+    begin
+      Source := PByte(Stored.GetPixels) + (Y shr ScaleShift) * Stored.PitchBytes;
+      Dest := PByte(GraphBuf.GetPixels) + Y * GraphBuf.PitchBytes;
+      for X := 0 to Width - 1 do
+        System.Move((Source + (X shr ScaleShift) * Bpp)^, (Dest + X * Bpp)^, Bpp);
+    end;
+  finally
+    Stored.Free;
+  end;
+end;
+{$ENDIF}
