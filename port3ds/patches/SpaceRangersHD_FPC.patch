+{$IFDEF CTR}
+// Fills a texture above the 3DS GPU limit at its stored (downscaled) size
+// straight from an uncompressed image, without a full-size buffer. The menu
+// backgrounds are 4096x1600; a full-size copy would take another 13 MiB.
+// Shift is the downscale from the image's stored pixels to the texture's.
+procedure FillScaledTextureFromRawGi(Image: TgiGR; Bits: Pointer; Pitch, Shift: Integer);
+var
+  Bpp, Width, Height, X, Y: Integer;
+  Plane: PgiPlaneGR;
+  Source, Dest: PByte;
+begin
+  Plane := Image.GetPlane(0);
+  if Plane.DataOffset = 0 then
+    Exit;
+  if Image.Header.AlphaMask = 0 then
+    Bpp := 2
+  else
+    Bpp := 4;
+  Width := Image.GetStoredSize.X;
+  Height := Image.GetStoredSize.Y;
+  Y := 0;
+  while Y < Height do
+  begin
+    Source := PByte(Image.Data) + Plane.DataOffset + Y * Width * Bpp;
+    Dest := PByte(Bits) + (Y shr Shift) * Pitch;
+    X := 0;
+    while X < Width do
+    begin
+      Move((Source + X * Bpp)^, Dest^, Bpp);
+      Inc(Dest, Bpp);
+      Inc(X, 1 shl Shift);
+    end;
+    Inc(Y, 1 shl Shift);
+  end;
+end;
+
+type
+  TRleScaledMode = (rsmAlpha, rsmTransAlpha, rsmTrans);
+
+// Draws one RLE plane (okgf rle.c layout: 16-byte header with the data size
+// and width, then per row runs of skip (n < 128) and literal (128 + n)
+// commands ending in 0, or 128 for an empty row) into the stored pixels of
+// a downscaled BGRA texture, keeping every (1 shl Shift)-th pixel. The modes
+// match OKGR_AlphaBuf_Draw_RGBA, OKGR_TransAlphaBuf_Draw_RGBA and
+// OKGR_TransBuf_Draw_RGBA.
+procedure DrawRlePlaneScaled(
+    Bits: PByte;
+    Pitch, Shift, OriginX, OriginY, ImageWidth, ImageHeight: Integer;
+    Source: PByte;
+    Mode: TRleScaledMode
+);
+var
+  Remaining, RowWidth, X, Y, PX, PY, N, I, InputBytes, Mask: Integer;
+  Command: Byte;
+  S, D: PByte;
+  V: Word;
+  A, R, G, B: Cardinal;
+begin
+  Remaining := PInteger(Source)^;
+  RowWidth := PInteger(Source + 4)^;
+  S := Source + 16;
+  Mask := (1 shl Shift) - 1;
+  if Mode = rsmAlpha then
+    InputBytes := 1
+  else
+    InputBytes := 2;
+  X := 0;
+  Y := 0;
+  while Remaining > 0 do
+  begin
+    Command := S^;
+    Inc(S);
+    Dec(Remaining);
+    if Command = 0 then
+    begin
+      Inc(Y);
+      Dec(X, RowWidth);
+    end
+    else if Command = 128 then
+      Inc(Y)
+    else if Command < 128 then
+      Inc(X, Command)
+    else
+    begin
+      N := Command and 127;
+      PY := OriginY + Y;
+      if ((PY and Mask) = 0) and (PY >= 0) and (PY < ImageHeight) then
+        for I := 0 to N - 1 do
+        begin
+          PX := OriginX + X + I;
+          if ((PX and Mask) <> 0) or (PX < 0) or (PX >= ImageWidth) then
+            Continue;
+          D := Bits + (PY shr Shift) * Pitch + (PX shr Shift) * 4;
+          if Mode = rsmAlpha then
+            D[3] := Byte(252 - 4 * Cardinal(S[I]))
+          else
+          begin
+            V := S[I * 2] or (Word(S[I * 2 + 1]) shl 8);
+            B := (V and 31) shl 3;
+            G := (V shr 3) and 252;
+            R := (V shr 8) and 248;
+            if Mode = rsmTransAlpha then
+            begin
+              A := D[3];
+              if A <> 0 then
+              begin
+                B := B * 255 div A;
+                G := G * 255 div A;
+                R := R * 255 div A;
+              end;
+            end
+            else
+              D[3] := 255;
+            D[0] := Byte(B);
+            D[1] := Byte(G);
+            D[2] := Byte(R);
+          end;
+        end;
+      Inc(S, N * InputBytes);
+      Dec(Remaining, N * InputBytes);
+      Inc(X, N);
+    end;
+  end;
+end;
+
+// Format 2 counterpart of FillScaledTextureFromRawGi: the same planes and
+// order as TgiGR.DecodeToPixels, drawn straight into the stored pixels.
+procedure FillScaledTextureFromRleGi(Image: TgiGR; Bits: Pointer; Pitch, Shift: Integer);
+const
+  PlaneModes: array[0..2] of TRleScaledMode = (rsmTrans, rsmTransAlpha, rsmAlpha);
+var
+  Order, PlaneIndex: Integer;
+  Plane: PgiPlaneGR;
+begin
+  for Order := 0 to 2 do
+  begin
+    PlaneIndex := 2 - Order;
+    Plane := Image.GetPlane(PlaneIndex);
+    if Plane.DataOffset <> 0 then
+      DrawRlePlaneScaled(
+          Bits,
+          Pitch,
+          Shift,
+          Plane.Bounds.Left - Image.Header.Bounds.Left,
+          Plane.Bounds.Top - Image.Header.Bounds.Top,
+          Image.GetStoredSize.X,
+          Image.GetStoredSize.Y,
+          PByte(Image.Data) + Plane.DataOffset,
+          PlaneModes[PlaneIndex]
+      );
+  end;
+end;
+
+// Creates the texture of an image or of a tile of it (Width x Height logical
+// pixels), stored at no more than the image's own stored size.
+function CreateGiTexture(Image: TgiGR; Width, Height: Integer): IDirect3DTexture9;
+begin
+  CtrTextureMinShift := Image.ScaleShift;
+  try
+    if (Image.Header.Format = 0) and (Image.Header.AlphaMask = 0) then
+      Result := GR_CreateTexture(Width, Height, D3DFMT_R5G6B5, D3DPOOL_MANAGED)
+    else
+      Result := GR_CreateTexture(Width, Height, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED);
+  finally
+    CtrTextureMinShift := 0;
+  end;
+end;
+
+// Fills the texture of a whole image when it is stored downscaled, because
+// the image is above the GPU limit or was downscaled by the asset converter.
+// Returns False for an ordinary texture, which is filled through LockRect.
+function FillScaledGiTexture(Texture: IDirect3DTexture9; Image: TgiGR): Boolean;
+var
+  Shift, Pitch: Integer;
+  Bits: Pointer;
+begin
+  Result := False;
+  if not CtrBeginScaledTextureFill(Texture, Shift, Bits, Pitch) then
+    Exit;
+  Dec(Shift, Image.ScaleShift);
+  if Shift = 0 then
+    Image.DecodeToPixels(Bits, Pitch, Image.GetStoredSize.X, Image.GetStoredSize.Y, True)
