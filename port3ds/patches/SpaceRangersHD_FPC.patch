+    FillScaledTextureFromRleGi(Image, Bits, Pitch, Shift)
+  else
+    AppendLogLineThreadSafe('No downscaling decoder for this GI format');
+  CtrEndScaledTextureFill(Texture);
+  Result := True;
+end;
+{$ENDIF}
