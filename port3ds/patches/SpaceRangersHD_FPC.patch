+{$IFDEF CTR}
+function TCGaiEC.LoadStreamed(const Path, LoadOption: WideString): Boolean;
+var
+  Entry: TDataElEC;
+  EntrySize, IndexSize, SequenceSize: Integer;
+  Probe: TGaiHeader;
+begin
+  Result := False;
+  // The AB2 background fixup rewrites the whole buffer.
+  if FindTextOffsetW(CacheKey, 'Bm.FormAB2.2bg') = 0 then
+    Exit;
+  Entry := GlobalCache.DataRoot.FindEntryByPath(Path);
+  if (Entry = nil) or (Entry.Kind <> dekFile) then
+    Exit;
+  EntrySize := GlobalCache.DataRoot.GetEntrySize(Entry);
+  if EntrySize < GaiStreamThreshold then
+    Exit;
+  GlobalCache.DataRoot.ReadEntryRange(Entry, 0, @Probe, SizeOf(Probe));
+  if (Probe.FrameCount < 0) or (Probe.FrameCount > 100000) then
+    Exit;
+  IndexSize := SizeOf(TGaiHeader) + Probe.FrameCount * SizeOf(TGaiFrameEntry);
+  SequenceSize := 0;
+  if Probe.SequenceTableOffset <> 0 then
+    SequenceSize := Probe.SequenceTableSize;
+  if (IndexSize > EntrySize) or (SequenceSize < 0)
+      or (Probe.SequenceTableOffset + SequenceSize > EntrySize) then
+    Exit;
+  if LoadOption = 'NoConvertPF' then
+    SkipPalettedColorCacheBuild := True;
+  RawGaiData := AllocEC(IndexSize);
+  GlobalCache.DataRoot.ReadEntryRange(Entry, 0, RawGaiData, IndexSize);
+  Header := RawGaiData;
+  if SequenceSize > 0 then
+  begin
+    StreamSequenceData := AllocEC(SequenceSize);
+    GlobalCache.DataRoot.ReadEntryRange(
+        Entry, Probe.SequenceTableOffset, StreamSequenceData, SequenceSize);
+    SequenceTableData := StreamSequenceData;
+  end;
+  StreamPath := Path;
+  Streamed := True;
+  ResidentBytes := IndexSize + SequenceSize;
+  SetLength(CachedFrameOrigins, Header.FrameCount);
+  Result := True;
+end;
+
+// Reads frame FrameIndex (or its first Size bytes when Size > 0) into
+// FrameData; Size returns the byte count read.
+function TCGaiEC.ReadStreamedFrame(FrameIndex: Integer; var Size: Integer): Boolean;
+var
+  Frame: PGaiFrameEntry;
+  Entry: TDataElEC;
+  ByteCount: Integer;
+begin
+  Result := False;
+  if (FrameIndex < 0) or (FrameIndex >= Header.FrameCount) then
+    Exit;
+  Frame := AddPointerOffset(RawGaiData, SizeOf(TGaiHeader) + FrameIndex * SizeOf(TGaiFrameEntry));
+  if (Frame.DataOffset = 0) or (Frame.DataSize <= 0) then
+    Exit;
+  ByteCount := Frame.DataSize;
+  if (Size > 0) and (Size < ByteCount) then
+    ByteCount := Size;
+  Entry := GlobalCache.DataRoot.FindEntryByPath(StreamPath);
+  if Entry = nil then
+    Exit;
+  // The decoded image may still reference FrameData (uncompressed frames).
+  LoadedFrameIndex := -1;
+  DecodedFrameGi.ClearData;
+  if ByteCount > FrameDataCapacity then
+  begin
+    if FrameData <> nil then
+      FreeEC(FrameData);
+    FrameData := nil;
+    FrameDataCapacity := 0;
+    FrameData := AllocEC(ByteCount);
+    FrameDataCapacity := ByteCount;
+  end;
+  GlobalCache.DataRoot.ReadEntryRange(Entry, Frame.DataOffset, FrameData, ByteCount);
+  Size := ByteCount;
+  Result := True;
+end;
+
+function TCGaiEC.LoadStreamedFrameGi(FrameIndex: Integer): TgiGR;
+var
+  Size: Integer;
+begin
+  Result := nil;
+  if (FrameIndex = LoadedFrameIndex) and not DecodedFrameGi.IsEmpty then
+    Exit(DecodedFrameGi);
+  Size := 0;
+  if not ReadStreamedFrame(FrameIndex, Size) then
+    Exit;
+  if (Size >= 2) and (ReadWordEC(FrameData) = $4C5A) then
+    DecodedFrameGi.LoadCompressedGiBytes(FrameData, Size)
+  else
+    DecodedFrameGi.LoadRawGiBytes(FrameData, Size);
+  if not SkipPalettedColorCacheBuild then
+    DecodedFrameGi.BuildPalettedFormat4ColorCache;
+  if DecodedFrameGi.IsEmpty then
+    Exit;
+  LoadedFrameIndex := FrameIndex;
+  Result := DecodedFrameGi;
+end;
+
+// Downscale of an animation converted by port3ds/tools/assetconv: its header
+// ends in "SC" and the shift. Its frames are downscaled images (see
+// TgiGR.ScaleShift); playback animations are composed at the stored size.
+function TCGaiEC.GetScaleShift: Integer;
+begin
+  Result := 0;
+  if (Header <> nil) and (Header.Gap28[0] = Ord('S')) and (Header.Gap28[1] = Ord('C')) then
+    Result := Header.Gap28[2];
+end;
+
+// A 700x700 frame is a 1024x1024 texture (4 MiB) on the 3DS, and the HD
+// animations have hundreds of frames: keep only the frame being shown.
+procedure TCGaiEC.KeepRecentSurface(FrameIndex: Integer);
+var
+  i: Integer;
+begin
+  for i := Low(RecentSurfaces) to High(RecentSurfaces) do
+    if RecentSurfaces[i] = FrameIndex then
+      Exit;
+  if RecentSurfaces[High(RecentSurfaces)] >= 0 then
+    FrameSurfaceCache.SetSurface(nil, RecentSurfaces[High(RecentSurfaces)]);
+  for i := High(RecentSurfaces) downto Low(RecentSurfaces) + 1 do
+    RecentSurfaces[i] := RecentSurfaces[i - 1];
+  RecentSurfaces[Low(RecentSurfaces)] := FrameIndex;
+end;
+{$ENDIF}
+
+{$IFDEF CTR}
+function TCGaiEC.IsOnScreen: Boolean;
+begin
+  Result := (FrameSurfaceCache <> nil) and (FrameSurfaceCache.LastUseTick <> 0)
+      and (GameTickCount - FrameSurfaceCache.LastUseTick < 8000);
+end;
+{$ENDIF}
+
 end.
