                           { LOC_REFERENCE always contains everything that's left }
                           paraloc^.loc:=LOC_REFERENCE;
-                          paraloc^.size:=int_cgsize(paralen);
+                          { a plain floating point value keeps its float size:
+                            the code generator loads it with VFP instructions
+                            and cannot store an integer-sized mm register }
+                          if (paradef.typ=floatdef) and
+                             (paracgsize in [OS_F32,OS_F64]) then
+                            begin
+                              paraloc^.size:=paracgsize;
+                              paraloc^.def:=paradef;
+                            end
+                          else
+                            paraloc^.size:=int_cgsize(paralen);
+                          { AAPCS: 8 byte aligned arguments start at an 8 byte
+                            aligned stack offset }
+                          if (target_info.abi in [abi_eabi,abi_eabihf]) and
+                             firstparaloc and
+                             (paradef.alignment=8) then
+                            begin
+                              stack_offset:=align(stack_offset,8);
+                              hp.paraloc[side].Alignment:=8;
+                            end;
                           if (side=callerside) then
                             paraloc^.reference.index:=NR_STACK_POINTER_REG;
                           paraloc^.reference.offset:=stack_offset;
