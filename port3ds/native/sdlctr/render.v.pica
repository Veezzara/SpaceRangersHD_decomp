; 2D vertex shader for the SDL renderer on the 3DS.
; v0 = position (x, y), v1 = texture coordinate (u, v), v2 = color (0..255)

.fvec projection[4]

.constf consts(0.0, 1.0, 0.00392156862745098, 0.0)
.alias zeros consts.xxxx
.alias ones consts.yyyy
.alias inv255 consts.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	mov r0.xy, inpos
	mov r0.z, zeros
	mov r0.w, ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intex
	mul outclr, inv255, inclr
	end
.end
